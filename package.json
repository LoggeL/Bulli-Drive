{
  "name": "bulli-drive",
  "version": "1.0.0",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,vite --prefix-colors blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:lan": "concurrently --kill-others-on-fail --names server,vite --prefix-colors blue,magenta \"tsx watch src/server/index.ts\" \"vite --host\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.worldviewer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bots": "vitest run --config vitest.bots.config.ts",
    "test:mutation": "stryker run",
    "bots": "tsx tools/bots/cli.ts",
    "test:e2e": "npm run build && playwright test --project=desktop --project=mobile",
    "test:e2e:render": "npm run build && playwright test --project=render",
    "perf:baseline": "npm run build && tsx scripts/perf-baseline.ts",
    "perf:sim": "tsx scripts/sim-bench.ts",
    "screenshots": "npm run build && tsx scripts/screenshots.ts",
    "ci": "npm run typecheck && npm test && npm run build",
    "worldviewer": "vite --config tools/worldviewer/vite.config.ts",
    "assets:models": "npm --prefix tools run models",
    "assets:textures": "npm --prefix tools run textures"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "uuid": "^13.0.0",
    "valibot": "^1.5.0",
    "ws": "^8.18.3"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.5",
    "lil-gui": "^0.20.0",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
